{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ranzevor/HarranCraft/main/schemas/inspection-v1.schema.json",
  "title": "HarranCraft binary inspection report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool_version",
    "results"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "tool_version": {
      "type": "string",
      "minLength": 1
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "input_index",
              "status",
              "image"
            ],
            "properties": {
              "input_index": {
                "type": "integer",
                "minimum": 1,
                "maximum": 16
              },
              "status": {
                "const": "inspected"
              },
              "image": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "sha256",
                  "file_size",
                  "machine",
                  "format",
                  "kind",
                  "coff_timestamp",
                  "image_size",
                  "entrypoint_rva",
                  "subsystem",
                  "file_versions",
                  "sections",
                  "export_count",
                  "named_export_count"
                ],
                "properties": {
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "file_size": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 536870912
                  },
                  "machine": {
                    "const": "amd64"
                  },
                  "format": {
                    "const": "PE32+"
                  },
                  "kind": {
                    "enum": [
                      "exe",
                      "dll"
                    ]
                  },
                  "coff_timestamp": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967295
                  },
                  "image_size": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967295
                  },
                  "entrypoint_rva": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967295
                  },
                  "subsystem": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 65535
                  },
                  "file_versions": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^\\d+\\.\\d+\\.\\d+\\.\\d+$"
                    },
                    "uniqueItems": true
                  },
                  "sections": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "rva",
                        "virtual_size",
                        "raw_offset",
                        "raw_size",
                        "characteristics"
                      ],
                      "properties": {
                        "rva": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 4294967295
                        },
                        "virtual_size": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 4294967295
                        },
                        "raw_offset": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 4294967295
                        },
                        "raw_size": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 4294967295
                        },
                        "characteristics": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 4294967295
                        }
                      }
                    },
                    "minItems": 1,
                    "maxItems": 96
                  },
                  "export_count": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 65536
                  },
                  "named_export_count": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 65536
                  },
                  "exports": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "ordinal",
                        "rva",
                        "names",
                        "forwarder"
                      ],
                      "properties": {
                        "ordinal": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 4294967295
                        },
                        "rva": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 4294967295
                        },
                        "names": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 4095
                          },
                          "uniqueItems": true
                        },
                        "forwarder": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "maxLength": 4095
                        }
                      }
                    },
                    "maxItems": 65536
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "input_index",
              "status",
              "error"
            ],
            "properties": {
              "input_index": {
                "type": "integer",
                "minimum": 1,
                "maximum": 16
              },
              "status": {
                "const": "error"
              },
              "error": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "code",
                  "message"
                ],
                "properties": {
                  "code": {
                    "enum": [
                      "invalid_pe",
                      "unsupported_machine",
                      "unsupported_format",
                      "ambiguous_sections",
                      "unbacked_rva",
                      "invalid_exports",
                      "invalid_resources",
                      "metadata_limit",
                      "file_limit",
                      "input_changed",
                      "not_regular_file",
                      "input_unreadable"
                    ]
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
